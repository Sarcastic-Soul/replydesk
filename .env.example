# Tinker (fine-tuned Qwen3.5-4B served through the OpenAI-compatible endpoint).
# If TINKER_MODEL_PATH is empty, the app returns offline mock replies.
TINKER_API_KEY=
TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
TINKER_MODEL_PATH=tinker://<run-id>/sampler_weights/<step>

# Backboard memory for shop facts. If empty, all saved facts are used for every reply.
BACKBOARD_API_KEY=

# Groq (promise check). If empty, a simple keyword check is used.
GROQ_API_KEY=

# Tiger Cloud Postgres. If empty, the app uses an in-memory sample store.
DATABASE_URL=
